APP_NAME=Arowin Trading Portal
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080/arowin

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arowin
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Company receive wallet for package purchases (TRC20 / ERC20)
AROWIN_USDT_ADDRESS=
AROWIN_USDT_NETWORK=TRC20

# Deposit: test = instant wallet credit | nowpayments = real gateway
DEPOSIT_MODE=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Required for instant Mass Payouts (no admin approve)
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
# Optional: Google Authenticator secret to auto-verify payout 2FA
# (or email whitelist@nowpayments.io to disable payout 2FA)
# NOWPAYMENTS_2FA_SECRET=
# payment = in-app unique address + QR | invoice = hosted NOWPayments page
NOWPAYMENTS_CHECKOUT_MODE=payment
NOWPAYMENTS_PAY_CURRENCY=usdtbsc
NOWPAYMENTS_PAYOUT_CURRENCY=usdtbsc
# Optional overrides (defaults built from APP_URL)
# NOWPAYMENTS_IPN_URL=https://arowintrading.com/dashboard/api/nowpayments-ipn.php
# NOWPAYMENTS_SANDBOX=false
# NOWPAYMENTS_MIN_DEPOSIT=1
# NOWPAYMENTS_MAX_DEPOSIT=100000
# NOWPAYMENTS_MIN_WITHDRAW=10
# NOWPAYMENTS_MAX_WITHDRAW=50000

# Outbound mail (registration, deposit credited, forgot password)
# Gmail: create a 16-character App Password and set MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=arowingtrading@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=arowingtrading@gmail.com
MAIL_FROM_NAME=Arowin Trading Company

# Firebase Phone OTP used to authorize withdrawals
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Admin panel (/admin) — change in production
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
# Email when withdrawals are queued due to low NOWPayments funds
# ADMIN_NOTIFY_EMAIL=you@example.com

COMPANY_TDS_PERCENT=5
COMPANY_ADMIN_PERCENT=5

# Show X-Arowin-Perf-Ms + Server-Timing on every response (or use ?_perf=1)
# APP_PERF=1
